# ============================================================
# EasyOffice Website — Environment Variables (Phase 1)
# Copy this file to `.env` and fill in local values.
# NEVER commit `.env` to git.
# ============================================================

# ---------------- Application ----------------
NODE_ENV=development
# Public base URL of the site (used for SEO canonicals, OG, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Internal server URL (Payload needs absolute URL for jobs/callbacks)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
PORT=3000

# ---------------- Database (PostgreSQL) ----------------
# Used by @payloadcms/db-postgres
DATABASE_URL=postgres://easyoffice:easyoffice@localhost:5433/easyoffice
# Individual parts (optional — compose DATABASE_URL from these if preferred)
POSTGRES_DB=easyoffice
POSTGRES_USER=easyoffice
POSTGRES_PASSWORD=easyoffice
POSTGRES_HOST=localhost
# Host port mapped to the container (5433 avoids clashing with a local Postgres on 5432)
POSTGRES_PORT=5433

# ---------------- Payload CMS ----------------
PAYLOAD_SECRET=CHANGE_ME_generate_a_long_random_string_min_32_chars
# First admin user (used by seed script only)
PAYLOAD_ADMIN_EMAIL=admin@easyoffice.local
PAYLOAD_ADMIN_PASSWORD=ChangeMe123!

# ---------------- Media (local storage, Phase 1) ----------------
# All uploads are stored on local disk under ./public/media
# so they can later migrate to object storage without frontend changes.
PAYLOAD_MEDIA_DIR=public/media
NEXT_PUBLIC_MEDIA_BASE_URL=/media

# ---------------- Future production (placeholders) ----------------
# S3 / object storage — NOT used in Phase 1, reserved for later migration
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
