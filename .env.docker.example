# Copy to .env.docker before running Docker Compose.
# Do not commit the copied .env.docker file.

NODE_ENV=production
APP_PORT=3000

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

POSTGRES_DB=easyoffice
POSTGRES_USER=easyoffice
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_PORT=5433
DATABASE_URL=postgresql://easyoffice:replace-with-a-strong-password@postgres:5432/easyoffice

# Must be at least 32 random characters in non-development environments.
PAYLOAD_SECRET=replace-with-a-long-random-secret
PAYLOAD_ADMIN_EMAIL=admin@easyoffice.local
PAYLOAD_ADMIN_PASSWORD=replace-with-a-strong-admin-password

PAYLOAD_MEDIA_DIR=public/media
NEXT_PUBLIC_MEDIA_BASE_URL=/media
